; Reverse-Lookup-Zone 192.168.10.0/24
$TTL 2D
@       IN  SOA srv1.gfn.internal. administrator.gfn.internal. (
                1       ; Serial
                8H      ; Refresh
                2H      ; Retry
                4W      ; Expire
                3H )    ; Minimum TTL

@       IN  NS      srv1.gfn.internal.

1       IN  PTR     router.gfn.internal.
10      IN  PTR     proxmox.gfn.internal.
11      IN  PTR     srv1.gfn.internal.
